# --- Storage -------------------------------------------------------------
# "local" = S3-compatible server at S3_ENDPOINT_URL (RustFS in docker compose,
# or MinIO/SeaweedFS/...); "cloud" = real AWS S3 (endpoint ignored).
STORAGE_MODE=local
# 127.0.0.1, not localhost: on Windows 'localhost' tries IPv6 ::1 first and
# stalls ~2 s per connection when the server only listens on IPv4.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=ransomware-backups
S3_REGION=us-east-1
# Locally these are also the object store's root credentials (compose passes
# them to RustFS). In cloud mode prefer an IAM role / AWS profile and leave blank.
AWS_ACCESS_KEY_ID=localadmin
AWS_SECRET_ACCESS_KEY=change-me-minio-secret

# --- Backup --------------------------------------------------------------
WATCH_DIR=./sandbox/watched
# Comma-separated glob patterns (matched against the relative POSIX path).
EXCLUDE_PATTERNS=*.tmp,*.swp,.DS_Store,~$*

# --- Restore -------------------------------------------------------------
RESTORE_DIR=./restore_out

# --- Detection -----------------------------------------------------------
MODEL_PATH=ml/artifacts/model.joblib
DETECTION_WINDOW_SECONDS=10
INCIDENT_COOLDOWN_SECONDS=60
ENTROPY_SAMPLE_BYTES=1048576

# --- Agent (Claude + RAG) -------------------------------------------------
# Get a key at https://console.anthropic.com/ ; leave unset to disable /agent/ask.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS=true
AGENT_MAX_TURNS=8
EMBEDDING_MODEL=all-MiniLM-L6-v2
AGENT_TIMEZONE=UTC

# --- Database ------------------------------------------------------------
DATABASE_URL=sqlite:///./data/metadata.db

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json   # or text for local dev
MONITOR_POLLING=false
